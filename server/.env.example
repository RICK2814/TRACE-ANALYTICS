MONGO_URI=mongodb://127.0.0.1:27017/analytics
PORT=4000
# comma separated list, or * for all
CORS_ORIGIN=*

# Replace all placeholders before using the admin dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Admin credentials. Use a strong unique password in production.
ADMIN_USERNAME=traceadmin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
