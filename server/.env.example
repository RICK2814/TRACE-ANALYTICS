MONGO_URI=mongodb://127.0.0.1:27017/analytics
PORT=4000
# Comma-separated allowed origins, or * for local development.
CORS_ORIGIN=*

# Admin account (configure only in your private Vercel environment settings).
ADMIN_USERNAME=traceadmin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Use a random value of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
